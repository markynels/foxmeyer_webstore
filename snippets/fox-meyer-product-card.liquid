{%- comment -%}
  A single shop product card with inline add-to-cart + Shop Pay express button.
  Params:
    product        (object, required)  — the Shopify product
    fallback_image (string)            — theme asset filename used if the product has no media
    badge          (string)            — corner badge label
    badge_green    (boolean)           — use green badge instead of orange
    notes          (string)            — tasting-notes eyebrow (e.g. "Brazil · Colombia")
    desc           (string)            — one-line description
    chip_1/2/3     (string)            — tasting / spec chips
    show_rating    (boolean)           — master toggle for the star rating + review count
    rating         (string)            — e.g. "4.9"
    rating_count   (string)            — e.g. "127"
    ship_note      (string)            — reassurance line under the buy buttons
    pdp_url        (string)            — link to full product page
{%- endcomment -%}
{%- if product != blank and product != empty -%}
  {%- assign v = product.selected_or_first_available_variant -%}
  <article class="fms-card">
    <a class="fms-card-media" href="{{ pdp_url | default: product.url }}" aria-label="{{ product.title }}">
      {%- if badge != blank -%}<span class="fms-badge {% if badge_green %}fms-badge-green{% endif %}">{{ badge }}</span>{%- endif -%}
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 700 | image_tag: alt: product.title, loading: 'lazy', widths: '350,500,700' }}
      {%- else -%}
        <img src="{{ fallback_image | default: 'fox-meyer-can-a.jpeg' | asset_url }}" alt="{{ product.title }}" loading="lazy" width="500" height="375">
      {%- endif -%}
    </a>
    <div class="fms-card-body">
      <div class="fms-card-head">
        <div>
          <h3 class="fms-card-name"><a href="{{ pdp_url | default: product.url }}" style="text-decoration:none;color:inherit">{{ product.title }}</a></h3>
          {%- if notes != blank -%}<div class="fms-card-notes">{{ notes }}</div>{%- endif -%}
        </div>
        <div class="fms-price">{{ v.price | money }}<small>CAD · 150 g</small></div>
      </div>

      {%- if show_rating and rating != blank -%}
        <div class="fms-rating">
          <span class="fms-stars" aria-hidden="true">★★★★★</span>
          <span class="fms-rating-text">{{ rating }}{% if rating_count != blank %} · {{ rating_count }} reviews{% endif %}</span>
        </div>
      {%- endif -%}

      {%- if desc != blank -%}<p class="fms-card-desc">{{ desc }}</p>{%- endif -%}

      {%- if chip_1 != blank or chip_2 != blank or chip_3 != blank -%}
        <div class="fms-chips">
          {%- if chip_1 != blank -%}<span class="fms-chip">{{ chip_1 }}</span>{%- endif -%}
          {%- if chip_2 != blank -%}<span class="fms-chip fms-chip-green">{{ chip_2 }}</span>{%- endif -%}
          {%- if chip_3 != blank -%}<span class="fms-chip">{{ chip_3 }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, data-fms-form: '', class: 'fms-buy' -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        <div class="fms-qtyrow">
          <div class="fms-qty" data-stepper>
            <button type="button" data-step="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="text" name="quantity" value="1" inputmode="numeric" pattern="[0-9]*" aria-label="Quantity">
            <button type="button" data-step="1" aria-label="Increase quantity">+</button>
          </div>
          <span class="fms-qty-label">cans</span>
        </div>
        {%- if v.available -%}
          <button type="submit" class="fms-btn fms-btn-orange" data-add>Add to cart — {{ v.price | money }}</button>
          {{ form | payment_button }}
        {%- else -%}
          <button type="button" class="fms-btn fms-btn-orange" disabled>Sold out</button>
        {%- endif -%}
        {%- if ship_note != blank -%}
          <p class="fms-ship-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ ship_note }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </article>
{%- endif -%}
