{%- comment -%}
  fox-meyer-structured-data — JSON-LD for the custom fox-meyer layout.
  Rendered once per page from layout/fox-meyer.liquid.

  Emits:
  - Organization (every page) — brand entity for Google / AI search; sameAs
    picks up whichever social links are filled in theme settings.
  - WebSite (homepage only).
  - Product offer data (product pages) via Shopify's structured_data filter.
  - BreadcrumbList (product + page templates).

  Deliberately NOT emitted: AggregateRating / Review — the on-page reviews are
  placeholder copy in section settings; marking them up would violate Google's
  review-snippet guidelines until real, verifiable reviews exist.
{%- endcomment -%}

{%- liquid
  assign org_logo = 'fox-meyer-logo.svg' | asset_url
  unless org_logo contains 'https:'
    assign org_logo = org_logo | prepend: 'https:'
  endunless

  assign social_links = ''
  if settings.social_instagram_link != blank
    assign social_links = social_links | append: settings.social_instagram_link | append: '|'
  endif
  if settings.social_facebook_link != blank
    assign social_links = social_links | append: settings.social_facebook_link | append: '|'
  endif
  if settings.social_tiktok_link != blank
    assign social_links = social_links | append: settings.social_tiktok_link | append: '|'
  endif
  if settings.social_youtube_link != blank
    assign social_links = social_links | append: settings.social_youtube_link | append: '|'
  endif
  if settings.social_twitter_link != blank
    assign social_links = social_links | append: settings.social_twitter_link | append: '|'
  endif
  if settings.social_pinterest_link != blank
    assign social_links = social_links | append: settings.social_pinterest_link | append: '|'
  endif
  assign social_arr = social_links | split: '|'

  assign org_desc_fallback = 'fms.meta.default_description' | t
  assign crumb_home = 'fms.breadcrumb.home' | t
  assign crumb_shop = 'fms.breadcrumb.shop' | t
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "logo": {{ org_logo | json }},
    "description": {{ shop.description | default: org_desc_fallback | json }},
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Dorval",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }{% if social_arr.size > 0 %},
    "sameAs": [{% for link in social_arr %}{{ link | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endif %}
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ crumb_home | json }}, "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ crumb_shop | json }}, "item": {{ shop.url | append: '/pages/shop' | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      ]
    }
  </script>
{%- elsif request.page_type == 'page' and page -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ crumb_home | json }}, "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
      ]
    }
  </script>
{%- endif -%}
