{%- comment -%}
  Branded store footer (matches the homepage). Usage:
    {% render 'fox-meyer-footer', legal: section.settings.footer_legal, copyright: section.settings.footer_copyright %}
{%- endcomment -%}
<footer class="fms-footer">
  <div class="fms-footer-row">
    <div>
      <a class="fms-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        <img src="{{ 'fox-meyer-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="100" height="29">
      </a>
      {%- if legal != blank -%}
        <p class="fms-fine">{{ legal | newline_to_br }}</p>
      {%- endif -%}
    </div>
    <nav class="fms-footer-links" aria-label="{{ 'fms.footer.aria' | t }}">
      <a href="{{ routes.root_url }}">{{ 'fms.footer.home' | t }}</a>
      <a href="{{ routes.root_url }}#fm-fraicheur">{{ 'fms.footer.freshness' | t }}</a>
      <a href="{{ routes.root_url }}#fm-origine">{{ 'fms.footer.blend' | t }}</a>
      <a href="{{ routes.root_url }}pages/shop#builder">{{ 'fms.footer.shop_all' | t }}</a>
      <a href="{{ routes.root_url }}pages/shop#faq">{{ 'fms.footer.help_faq' | t }}</a>
    </nav>
  </div>
  {%- assign copyright_fallback = 'fms.footer.copyright_fallback' | t -%}
  <p class="fms-footer-copy">{{ copyright | default: copyright_fallback }}</p>
</footer>
