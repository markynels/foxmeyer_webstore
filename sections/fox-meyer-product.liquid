{%- comment -%}
  Fox Meyer — branded high-converting PDP. Replaces the stock Dawn product page.
  Uses the live `product` object so price, availability and media stay accurate.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600&family=Barlow+Condensed:wght@600;700;800&display=swap">
{{ 'fox-meyer-store.css' | asset_url | stylesheet_tag }}

{% render 'fox-meyer-store-config' %}
<script src="{{ 'fox-meyer-store.js' | asset_url }}" defer></script>

{%- assign v = product.selected_or_first_available_variant -%}
{%- comment -%} fallback can image by handle when the product has no media {%- endcomment -%}
{%- if product.handle contains 'grenouille' -%}{%- assign fallback = 'fox-meyer-can-b.jpeg' -%}{%- else -%}{%- assign fallback = 'fox-meyer-can-a.jpeg' -%}{%- endif -%}

<div class="fms">
  {% render 'fox-meyer-header' %}

  <div class="fms-wrap">
    <section class="fms-container fms-pdp">

      <!-- Gallery -->
      <div class="fms-gallery">
        <div class="fms-gallery-main">
          {%- if product.featured_media -%}
            <img data-gallery-main src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title }}" width="900" height="900">
          {%- else -%}
            <img data-gallery-main src="{{ fallback | asset_url }}" alt="{{ product.title }}" width="700" height="700">
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="fms-thumbs">
            {%- for media in product.media limit: 5 -%}
              <button type="button" class="fms-thumb {% if forloop.first %}is-active{% endif %}" data-thumb="{{ media | image_url: width: 900 }}" aria-label="{{ 'fms.product.view_image' | t: number: forloop.index }}">
                <img src="{{ media | image_url: width: 150 }}" alt="" loading="lazy" width="150" height="150">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info / buy box -->
      <div class="fms-pdp-info">
        <div class="fms-pdp-sub">{{ section.settings.sub_label | default: product.vendor }}</div>
        <h1 class="fms-pdp-title">{{ product.title }}</h1>

        {%- if section.settings.show_ratings and section.settings.rating != blank -%}
          <div class="fms-rating">
            <span class="fms-stars" aria-hidden="true">★★★★★</span>
            <span class="fms-rating-text">{{ section.settings.rating }}{% if section.settings.rating_count != blank %} · {{ section.settings.rating_count }} {{ 'fms.product.reviews' | t }}{% endif %}</span>
          </div>
        {%- endif -%}

        <div class="fms-pdp-pricerow">
          <span class="fms-price">{{ v.price | money }}</span>
          <span class="fms-qty-label">{{ section.settings.unit_label | default: 'CAD · per 150 g can' }}</span>
        </div>

        <div class="fms-pdp-desc">
          {%- if product.description != blank -%}{{ product.description }}{%- else -%}<p>{{ section.settings.fallback_desc }}</p>{%- endif -%}
        </div>

        {%- assign chips = section.settings.spec_chips | split: '|' -%}
        {%- if chips.size > 0 -%}
          <div class="fms-chips">
            {%- for c in chips -%}<span class="fms-chip {% if forloop.index == 2 %}fms-chip-green{% endif %}">{{ c | strip }}</span>{%- endfor -%}
          </div>
        {%- endif -%}

        <hr class="fms-divider">

        <!-- Buy: cans ship only inside a 4 or 8-can box, built on the Shop page -->
        <div class="fms-buy" data-sticky-anchor>
          <a class="fms-btn fms-btn-orange" href="{{ routes.root_url }}pages/shop#builder">{{ section.settings.buy_cta | default: 'Add to a box' }}</a>
          {%- if section.settings.buy_note != blank -%}
            <p class="fms-ship-note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{ section.settings.buy_note }}
            </p>
          {%- endif -%}
        </div>

        <hr class="fms-divider">

        <!-- Recipe -->
        {%- if section.settings.show_recipe -%}
          {%- comment -%} Per-product recipe: both cans share this template, so pick the Grenouille values by handle {%- endcomment -%}
          {%- if product.handle contains 'grenouille' -%}
            {%- assign r_water = section.settings.g_recipe_water -%}
            {%- assign r_dose = section.settings.g_recipe_dose -%}
            {%- assign r_yield = section.settings.g_recipe_yield -%}
            {%- assign r_time = section.settings.g_recipe_time -%}
          {%- else -%}
            {%- assign r_water = section.settings.recipe_water -%}
            {%- assign r_dose = section.settings.recipe_dose -%}
            {%- assign r_yield = section.settings.recipe_yield -%}
            {%- assign r_time = section.settings.recipe_time -%}
          {%- endif -%}
          <p class="fms-eyebrow" style="margin-bottom:8px">{{ section.settings.recipe_eyebrow }}</p>
          <div class="fms-recipe">
            <div><div class="fms-num">{{ r_water }}<span>°C</span></div><div class="fms-lab">Water</div></div>
            <div><div class="fms-num">{{ r_dose }}<span>g</span></div><div class="fms-lab">Dose</div></div>
            <div><div class="fms-num">{{ r_yield }}<span>g</span></div><div class="fms-lab">Yield</div></div>
            <div><div class="fms-num">{{ r_time }}<span>s</span></div><div class="fms-lab">Time</div></div>
          </div>
        {%- endif -%}
      </div>
    </section>

    <!-- Trust row -->
    <section class="fms-container fms-section" id="why">
      <div class="fms-values">
        <div class="fms-value"><div class="fms-value-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="3" width="10" height="18" rx="3"/><path d="M7 8h10" stroke-linecap="round"/></svg></div><h3>{{ section.settings.why_1_title }}</h3><p>{{ section.settings.why_1 }}</p></div>
        <div class="fms-value"><div class="fms-value-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="14" r="6"/><path d="M9 3l3 6 3-6" stroke-linejoin="round"/></svg></div><h3>{{ section.settings.why_2_title }}</h3><p>{{ section.settings.why_2 }}</p></div>
        <div class="fms-value"><div class="fms-value-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h11v9H2zM13 10h5l3 3v3h-8z" stroke-linejoin="round"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg></div><h3>{{ section.settings.why_3_title }}</h3><p>{{ section.settings.why_3 }}</p></div>
        <div class="fms-value"><div class="fms-value-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></div><h3>{{ section.settings.why_4_title }}</h3><p>{{ section.settings.why_4 }}</p></div>
      </div>
    </section>
  </div>

  {% render 'fox-meyer-footer', legal: section.settings.footer_legal, copyright: section.settings.footer_copyright %}

  <!-- Sticky mobile buy bar -->
  <div class="fms-stickybar" aria-hidden="true">
    <span class="fms-price">{{ v.price | money }}<small>{{ 'fms.product.per_can' | t }}</small></span>
    <a class="fms-btn fms-btn-orange" href="{{ routes.root_url }}pages/shop#builder">{{ section.settings.buy_cta | default: 'Add to a box' }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Fox Meyer Product",
  "settings": [
    { "type": "header", "content": "Buy box" },
    { "type": "text", "id": "sub_label", "label": "Eyebrow above title", "default": "Specialty espresso · Nitrogen-sealed" },
    { "type": "text", "id": "unit_label", "label": "Unit label beside price", "default": "CAD · per 150 g can" },
    { "type": "text", "id": "spec_chips", "label": "Spec chips (separate with | )", "default": "150 g · Whole bean | Nitrogen-flushed | SCA 86+ | Recyclable aluminium" },
    { "type": "text", "id": "buy_cta", "label": "Buy button label", "info": "Cans sell only inside a 4 or 8-can box. This button sends shoppers to the box builder on the Shop page.", "default": "Add to a box" },
    { "type": "text", "id": "buy_note", "label": "Note under buy button", "default": "Sold in mix-and-match 4 & 8-can boxes — free shipping, always." },
    { "type": "textarea", "id": "fallback_desc", "label": "Description fallback (if product has none)", "default": "Competition-grade beans, small-batch roasted in Dorval and nitrogen-sealed in aluminium for roast-day freshness in every cup." },

    { "type": "header", "content": "Ratings" },
    { "type": "checkbox", "id": "show_ratings", "label": "Show star rating + review count", "info": "Off until real reviews exist. The values below are kept for when you turn it on.", "default": false },
    { "type": "text", "id": "rating", "label": "Rating value", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Rating count", "default": "127" },

    { "type": "header", "content": "Recipe — Fox Meyer (default)" },
    { "type": "checkbox", "id": "show_recipe", "label": "Show recipe", "default": true },
    { "type": "text", "id": "recipe_eyebrow", "label": "Eyebrow", "default": "A starting recipe" },
    { "type": "text", "id": "recipe_water", "label": "Water °C", "default": "90" },
    { "type": "text", "id": "recipe_dose", "label": "Dose g", "default": "18" },
    { "type": "text", "id": "recipe_yield", "label": "Yield g", "default": "36" },
    { "type": "text", "id": "recipe_time", "label": "Time s", "default": "32" },

    { "type": "header", "content": "Recipe — Petite Grenouille", "info": "Used only on the Petite Grenouille page." },
    { "type": "text", "id": "g_recipe_water", "label": "Water °C", "default": "89" },
    { "type": "text", "id": "g_recipe_dose", "label": "Dose g", "default": "19" },
    { "type": "text", "id": "g_recipe_yield", "label": "Yield g", "default": "36" },
    { "type": "text", "id": "g_recipe_time", "label": "Time s", "default": "30" },

    { "type": "header", "content": "Why Fox Meyer (trust row)" },
    { "type": "text", "id": "why_1_title", "label": "Title 1", "default": "Nitrogen-sealed" },
    { "type": "textarea", "id": "why_1", "label": "Body 1", "default": "No oxygen, no light — roast-day flavour, locked in." },
    { "type": "text", "id": "why_2_title", "label": "Title 2", "default": "Competition-grade" },
    { "type": "textarea", "id": "why_2", "label": "Body 2", "default": "SCA 86+ beans, small-batch roasted in Québec." },
    { "type": "text", "id": "why_3_title", "label": "Title 3", "default": "Ships in 1–2 days" },
    { "type": "textarea", "id": "why_3", "label": "Body 3", "default": "Roasted to order, shipped from Dorval in 1–2 days." },
    { "type": "text", "id": "why_4_title", "label": "Title 4", "default": "100-day guarantee" },
    { "type": "textarea", "id": "why_4", "label": "Body 4", "default": "Don’t love it within 100 days? We’ll make it right." },

    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "footer_legal", "label": "Legal text", "default": "Fox Meyer® — registered trademark. Prepared in Canada using imported beans. Recycle where facilities exist." },
    { "type": "text", "id": "footer_copyright", "label": "Copyright line", "default": "© 2026 Fox Meyer®. All rights reserved." }
  ]
}
{% endschema %}
