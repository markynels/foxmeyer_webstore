{%- comment -%}
  Fox Meyer — unified Shop hub. The DTC store sells two box formats only:
  a 4-can box and an 8-can box, both mix-and-match between the two coffees,
  both free shipping. No single-can purchase. The box builder lets the shopper
  pick a size, split the cans between Fox Meyer and Petite Grenouille, and add
  the whole box to cart in one action (price = sum of the chosen cans).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600&family=Barlow+Condensed:wght@600;700;800&display=swap">
{{ 'fox-meyer-store.css' | asset_url | stylesheet_tag }}

{% render 'fox-meyer-store-config' %}
<script src="{{ 'fox-meyer-store.js' | asset_url }}" defer></script>

{%- assign p1 = section.settings.product_1 | default: all_products['fox-meyer'] -%}
{%- assign p2 = section.settings.product_2 | default: all_products['petite-grenouille'] -%}
{%- assign fv = p1.selected_or_first_available_variant -%}
{%- assign gv = p2.selected_or_first_available_variant -%}

<div class="fms">
  {% render 'fox-meyer-header', shop_url: request.path, on_shop: true %}

  <div class="fms-wrap">

    <!-- Box builder -->
    <section class="fms-container fms-section" id="builder">
      <p class="fms-eyebrow fms-center">{{ section.settings.builder_eyebrow }}</p>
      <h1 class="fms-h2 fms-center">{{ section.settings.builder_heading }}</h1>
      {%- if section.settings.builder_sub != blank -%}
        <p class="fms-lead fms-center" style="margin:16px auto 0">{{ section.settings.builder_sub }}</p>
      {%- endif -%}

      {%- if p1 != blank and p2 != blank and fv != blank and gv != blank -%}
        <div class="fms-builder"
             data-box-builder
             data-fox-id="{{ fv.id }}" data-fox-price="{{ fv.price }}"
             data-gren-id="{{ gv.id }}" data-gren-price="{{ gv.price }}">

          <!-- Size toggle -->
          <div class="fms-box-sizes" role="tablist" aria-label="{{ 'fms.shop.box_size_aria' | t }}">
            <button type="button" class="fms-box-size is-active" data-box-size="4" role="tab" aria-selected="true">
              <span class="fms-box-size-n">4</span>
              <span class="fms-box-size-l">{{ section.settings.box4_label }}</span>
            </button>
            <button type="button" class="fms-box-size" data-box-size="8" role="tab" aria-selected="false">
              {%- if section.settings.box8_flag != blank -%}<span class="fms-box-flag">{{ section.settings.box8_flag }}</span>{%- endif -%}
              <span class="fms-box-size-n">8</span>
              <span class="fms-box-size-l">{{ section.settings.box8_label }}</span>
            </button>
          </div>

          <!-- Can pickers -->
          <div class="fms-box-cans">
            {%- comment -%} Fox Meyer {%- endcomment -%}
            <div class="fms-box-can">
              <div class="fms-box-can-media">
                <img src="{{ 'fox-meyer-char-fox.png' | asset_url }}" alt="{{ p1.title }}" loading="lazy" width="120" height="120">
              </div>
              <div class="fms-box-can-info">
                <h3 class="fms-box-can-name">{{ p1.title }}</h3>
                {%- if section.settings.p1_notes != blank -%}<div class="fms-card-notes">{{ section.settings.p1_notes }}</div>{%- endif -%}
                <div class="fms-box-can-price">{{ fv.price | money }} <small>{{ 'fms.shop.per_can' | t }}</small></div>
                {%- if section.settings.p1_chips != blank -%}
                  <div class="fms-box-can-chips">
                    {%- assign p1chips = section.settings.p1_chips | split: '·' -%}
                    {%- for c in p1chips -%}<span>{{ c | strip }}</span>{%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="fms-qty" data-can-stepper="fox">
                <button type="button" data-can-step="-1" aria-label="{{ 'fms.shop.remove_one' | t: product: p1.title }}">&minus;</button>
                <input type="text" inputmode="numeric" value="2" data-can-input="fox" aria-label="{{ 'fms.shop.can_count_aria' | t: product: p1.title }}" readonly>
                <button type="button" data-can-step="1" aria-label="{{ 'fms.shop.add_one' | t: product: p1.title }}">+</button>
              </div>
            </div>

            {%- comment -%} Petite Grenouille {%- endcomment -%}
            <div class="fms-box-can">
              <div class="fms-box-can-media">
                <img src="{{ 'fox-meyer-char-grenouille.png' | asset_url }}" alt="{{ p2.title }}" loading="lazy" width="120" height="120">
              </div>
              <div class="fms-box-can-info">
                <h3 class="fms-box-can-name">{{ p2.title }}</h3>
                {%- if section.settings.p2_notes != blank -%}<div class="fms-card-notes">{{ section.settings.p2_notes }}</div>{%- endif -%}
                <div class="fms-box-can-price">{{ gv.price | money }} <small>{{ 'fms.shop.per_can' | t }}</small></div>
                {%- if section.settings.p2_chips != blank -%}
                  <div class="fms-box-can-chips">
                    {%- assign p2chips = section.settings.p2_chips | split: '·' -%}
                    {%- for c in p2chips -%}<span>{{ c | strip }}</span>{%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="fms-qty" data-can-stepper="gren">
                <button type="button" data-can-step="-1" aria-label="{{ 'fms.shop.remove_one' | t: product: p2.title }}">&minus;</button>
                <input type="text" inputmode="numeric" value="2" data-can-input="gren" aria-label="{{ 'fms.shop.can_count_aria' | t: product: p2.title }}" readonly>
                <button type="button" data-can-step="1" aria-label="{{ 'fms.shop.add_one' | t: product: p2.title }}">+</button>
              </div>
            </div>
          </div>

          {%- if section.settings.box8_perk != blank -%}
            <p class="fms-box-musette" data-box-musette hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{ section.settings.box8_perk }}
            </p>
          {%- endif -%}

          <!-- Summary / add -->
          <div class="fms-box-summary">
            <div class="fms-box-status">
              <div class="fms-box-dots" data-box-dots aria-hidden="true"></div>
              <p class="fms-box-count">{{ 'fms.shop.progress_html' | t }}</p>
            </div>
            <div class="fms-box-total">
              <span>{{ 'fms.shop.box_total' | t }}</span>
              <strong data-box-total>{{ 0 | money }}</strong>
            </div>
            <button type="button" class="fms-btn fms-btn-orange" data-box-add disabled>
              <span data-box-add-label>{{ 'fms.shop.pick_your_cans' | t }}</span>
            </button>
          </div>
        </div>
      {%- else -%}
        <p class="fms-lead fms-center" style="margin-top:24px">
          The box builder needs both coffees connected. Set Product 1 and Product 2 in the section settings.
        </p>
      {%- endif -%}
    </section>

    <!-- Why Fox Meyer -->
    <section class="fms-container fms-section" id="why" style="padding-top:0">
      <p class="fms-eyebrow fms-center">{{ section.settings.why_eyebrow }}</p>
      <h2 class="fms-h2 fms-center" style="margin-bottom:48px">{{ section.settings.why_heading }}</h2>
      <div class="fms-values">
        {%- for i in (1..4) -%}
          {%- assign t = 'why_' | append: i | append: '_title' -%}
          {%- assign b = 'why_' | append: i | append: '_body' -%}
          {%- assign ic = 'why_' | append: i | append: '_icon' -%}
          {%- assign icon = section.settings[ic] -%}
          <div class="fms-value">
            <div class="fms-value-ic">
              {%- case icon -%}
                {%- when 'nitrogen' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="3" width="10" height="18" rx="3"/><path d="M7 8h10" stroke-linecap="round"/></svg>
                {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 4S8 4 6 12c-1 5 3 8 3 8M20 4c0 8-5 11-10 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'medal' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="14" r="6"/><path d="M9 3l3 6 3-6" stroke-linejoin="round"/></svg>
                {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h11v9H2zM13 10h5l3 3v3h-8z" stroke-linejoin="round"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </div>
            <h3>{{ section.settings[t] }}</h3>
            <p>{{ section.settings[b] }}</p>
          </div>
        {%- endfor -%}
      </div>
    </section>

    <!-- Reviews -->
    {%- if section.settings.show_reviews -%}
    <section class="fms-container fms-section" id="reviews" style="padding-top:0">
      <p class="fms-eyebrow fms-center">{{ section.settings.reviews_eyebrow }}</p>
      <h2 class="fms-h2 fms-center" style="margin-bottom:48px">{{ section.settings.reviews_heading }}</h2>
      <div class="fms-reviews">
        {%- for i in (1..3) -%}
          {%- assign q = 'review_' | append: i | append: '_quote' -%}
          {%- assign n = 'review_' | append: i | append: '_name' -%}
          {%- if section.settings[q] != blank -%}
            <figure class="fms-review">
              {%- if section.settings.show_ratings -%}<div class="fms-stars" aria-hidden="true">★★★★★</div>{%- endif -%}
              <blockquote>{{ section.settings[q] }}</blockquote>
              <cite>{{ section.settings[n] }}</cite>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

    <!-- FAQ -->
    <section class="fms-container fms-section" id="faq" style="padding-top:0">
      <p class="fms-eyebrow fms-center">{{ section.settings.faq_eyebrow }}</p>
      <h2 class="fms-h2 fms-center" style="margin-bottom:40px">{{ section.settings.faq_heading }}</h2>
      <div class="fms-faq">
        {%- for i in (1..6) -%}
          {%- assign q = 'faq_' | append: i | append: '_q' -%}
          {%- assign a = 'faq_' | append: i | append: '_a' -%}
          {%- if section.settings[q] != blank -%}
            <details {% if i == 1 %}open{% endif %}>
              <summary>{{ section.settings[q] }}</summary>
              <div class="fms-faq-a">{{ section.settings[a] | newline_to_br }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>

  </div>

  {% render 'fox-meyer-footer', legal: section.settings.footer_legal, copyright: section.settings.footer_copyright %}
</div>

{%- comment -%} FAQPage JSON-LD mirroring the visible FAQ accordion above. {%- endcomment -%}
{%- capture faq_entities -%}
  {%- for i in (1..6) -%}
    {%- assign qk = 'faq_' | append: i | append: '_q' -%}
    {%- assign ak = 'faq_' | append: i | append: '_a' -%}
    {%- if section.settings[qk] != blank and section.settings[ak] != blank -%}
      {"@type":"Question","name":{{ section.settings[qk] | json }},"acceptedAnswer":{"@type":"Answer","text":{{ section.settings[ak] | json }}}},
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign faq_entities = faq_entities | strip | remove_last: ',' -%}
{%- if faq_entities != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_entities }}]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Fox Meyer Shop",
  "settings": [
    { "type": "header", "content": "Box builder" },
    { "type": "text", "id": "builder_eyebrow", "label": "Eyebrow", "default": "Build your box" },
    { "type": "text", "id": "builder_heading", "label": "Heading", "default": "Four or eight. Your blend." },
    { "type": "textarea", "id": "builder_sub", "label": "Subheading", "default": "Every box ships free. New to Fox Meyer? Split a four-can box two-and-two and meet both blends at once." },
    { "type": "text", "id": "box4_label", "label": "4-can — label", "default": "Can box" },
    { "type": "text", "id": "box8_label", "label": "8-can — label", "default": "Can box" },
    { "type": "text", "id": "box8_flag", "label": "8-can — flag", "default": "+ Collectible musette" },
    { "type": "text", "id": "box8_perk", "label": "8-can perk note (shown when 8 is selected)", "default": "Your 8-can box includes a limited-edition Fox Meyer musette — on us." },

    { "type": "header", "content": "Coffee 1 (left)" },
    { "type": "product", "id": "product_1", "label": "Product (defaults to “fox-meyer”)" },
    { "type": "text", "id": "p1_notes", "label": "Origin eyebrow", "default": "Brazil · Colombia · Medium-dark" },
    { "type": "text", "id": "p1_chips", "label": "Flavour notes (separate with · )", "info": "Short keywords shown as chips. Full prose lives on the product page.", "default": "Velvety caramel · Dark cocoa · Toasted almond" },

    { "type": "header", "content": "Coffee 2 (right)" },
    { "type": "product", "id": "product_2", "label": "Product (defaults to “petite-grenouille”)" },
    { "type": "text", "id": "p2_notes", "label": "Origin eyebrow", "default": "Brazil · India · Guatemala · Medium-dark" },
    { "type": "text", "id": "p2_chips", "label": "Flavour notes (separate with · )", "info": "Short keywords shown as chips. Full prose lives on the product page.", "default": "Rich molasses · Dark cocoa · Walnut finish" },

    { "type": "header", "content": "Why Fox Meyer" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why Fox Meyer" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "Built for the cup, not the shelf." },
    { "type": "select", "id": "why_1_icon", "label": "Icon 1", "default": "nitrogen", "options": [
      { "value": "nitrogen", "label": "Can" }, { "value": "leaf", "label": "Leaf" }, { "value": "medal", "label": "Medal" }, { "value": "truck", "label": "Truck" }, { "value": "check", "label": "Check" } ] },
    { "type": "text", "id": "why_1_title", "label": "Title 1", "default": "Nitrogen-sealed" },
    { "type": "textarea", "id": "why_1_body", "label": "Body 1", "default": "Flushed with nitrogen in aluminium — no oxygen, no light, no stale coffee. Roast-day flavour in every cup." },
    { "type": "select", "id": "why_2_icon", "label": "Icon 2", "default": "medal", "options": [
      { "value": "nitrogen", "label": "Can" }, { "value": "leaf", "label": "Leaf" }, { "value": "medal", "label": "Medal" }, { "value": "truck", "label": "Truck" }, { "value": "check", "label": "Check" } ] },
    { "type": "text", "id": "why_2_title", "label": "Title 2", "default": "Competition-grade" },
    { "type": "textarea", "id": "why_2_body", "label": "Body 2", "default": "Beans scoring SCA 86+, small-batch roasted in Dorval, Québec. The quality baristas chase, at home." },
    { "type": "select", "id": "why_3_icon", "label": "Icon 3", "default": "truck", "options": [
      { "value": "nitrogen", "label": "Can" }, { "value": "leaf", "label": "Leaf" }, { "value": "medal", "label": "Medal" }, { "value": "truck", "label": "Truck" }, { "value": "check", "label": "Check" } ] },
    { "type": "text", "id": "why_3_title", "label": "Title 3", "default": "Roasted to order" },
    { "type": "textarea", "id": "why_3_body", "label": "Body 3", "default": "We roast after you order and ship within 1–2 business days. It doesn’t sit in a warehouse." },
    { "type": "select", "id": "why_4_icon", "label": "Icon 4", "default": "leaf", "options": [
      { "value": "nitrogen", "label": "Can" }, { "value": "leaf", "label": "Leaf" }, { "value": "medal", "label": "Medal" }, { "value": "truck", "label": "Truck" }, { "value": "check", "label": "Check" } ] },
    { "type": "text", "id": "why_4_title", "label": "Title 4", "default": "Endlessly recyclable" },
    { "type": "textarea", "id": "why_4_body", "label": "Body 4", "default": "Aluminium is infinitely recyclable — unlike most foil coffee bags. Better cup, lighter footprint." },

    { "type": "header", "content": "Ratings" },
    { "type": "checkbox", "id": "show_ratings", "label": "Show star rating on testimonials", "info": "Off until real reviews exist. Controls the stars on testimonials.", "default": false },

    { "type": "header", "content": "Reviews / social proof" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews section", "default": true },
    { "type": "text", "id": "reviews_eyebrow", "label": "Eyebrow", "default": "Loved by" },
    { "type": "text", "id": "reviews_heading", "label": "Heading", "default": "What the cup says." },
    { "type": "textarea", "id": "review_1_quote", "label": "Review 1 — quote", "default": "Genuinely the freshest coffee I’ve had shipped to me. The can makes a real difference — it tastes like it was roasted yesterday." },
    { "type": "text", "id": "review_1_name", "label": "Review 1 — name", "default": "Mathieu L. · Montréal" },
    { "type": "textarea", "id": "review_2_quote", "label": "Review 2 — quote", "default": "Pulls a beautiful espresso. Caramel and cocoa exactly as described. The Petite Grenouille is my new daily." },
    { "type": "text", "id": "review_2_name", "label": "Review 2 — name", "default": "Sarah K. · Toronto" },
    { "type": "textarea", "id": "review_3_quote", "label": "Review 3 — quote", "default": "Built a box, two of each, free shipping, arrived in two days. Packaging is gorgeous. Reordering already." },
    { "type": "text", "id": "review_3_name", "label": "Review 3 — name", "default": "Daniel P. · Ottawa" },

    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Questions, answered." },
    { "type": "text", "id": "faq_1_q", "label": "Q1", "default": "How does the box work?" },
    { "type": "textarea", "id": "faq_1_a", "label": "A1", "default": "Pick a four- or eight-can box, then split it between Fox Meyer and Petite Grenouille however you like — all Fox, all Grenouille, or any mix. Every box ships free. New here? A four-can box, two of each, is the easiest way to taste both." },
    { "type": "text", "id": "faq_2_q", "label": "Q2", "default": "Whole bean or ground?" },
    { "type": "textarea", "id": "faq_2_a", "label": "A2", "default": "Every can ships as whole bean to protect freshness — 150 g per can. Grinding fresh is the single biggest upgrade to your cup." },
    { "type": "text", "id": "faq_3_q", "label": "Q3", "default": "How many espressos in a box?" },
    { "type": "textarea", "id": "faq_3_a", "label": "A3", "default": "Every can holds 150 g of whole bean — the question is how far that goes, and that depends on how you pull your shots. A single takes about 9 g; a double, about 18 g.\n\nRoughly:\nOne can (150 g) — ~16 singles, or ~8 doubles\nFour-can box (600 g) — ~66 singles, or ~33 doubles\nEight-can box (1.2 kg) — ~133 singles, or ~66 doubles\n\nPut another way: a four-can box is about a month of a daily double; an eight-can box, about two." },
    { "type": "text", "id": "faq_4_q", "label": "Q4", "default": "When will it arrive?" },
    { "type": "textarea", "id": "faq_4_a", "label": "A4", "default": "Orders ship from Dorval, Québec within 1–2 business days. Most of Canada arrives in 2–5 business days. Shipping is always free." },
    { "type": "text", "id": "faq_5_q", "label": "Q5", "default": "What if I don’t love it?" },
    { "type": "textarea", "id": "faq_5_a", "label": "A5", "default": "Tell us within 100 days and we’ll make it right with a replacement or refund. No returning half-finished cans required." },
    { "type": "text", "id": "faq_6_q", "label": "Q6", "default": "Can I pay with Shop Pay / Apple Pay?" },
    { "type": "textarea", "id": "faq_6_a", "label": "A6", "default": "Yes. At checkout you can pay in seconds with Shop Pay, Apple Pay or Google Pay — no account or address typing needed." },

    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "footer_legal", "label": "Legal text", "default": "Fox Meyer® — registered trademark. Prepared in Canada using imported beans (Brazil & Colombia). Recycle where facilities exist." },
    { "type": "text", "id": "footer_copyright", "label": "Copyright line", "default": "© 2026 Fox Meyer®. All rights reserved." }
  ],
  "presets": [ { "name": "Fox Meyer Shop" } ]
}
{% endschema %}
