<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600&family=Barlow+Condensed:wght@600;700;800&display=swap">

{{ 'fox-meyer-homepage.css' | asset_url | stylesheet_tag }}

<script>
  window.foxMeyerCanA = '{{ "fox-meyer-can-a.jpeg" | asset_url }}';
  window.foxMeyerCanB = '{{ "fox-meyer-can-b.jpeg" | asset_url }}';
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script src="{{ 'fox-meyer-homepage.js' | asset_url }}" defer></script>

<div class="fm-page">

  <!-- Loader -->
  <div id="fm-loader" class="fm-loader" aria-hidden="true">
    <img src="{{ 'fox-meyer-logo.svg' | asset_url }}" alt="" width="260" height="75">
  </div>

  <!-- Background layers -->
  <div id="fm-bg-green" class="fm-bg-green" aria-hidden="true"></div>
  <canvas id="fm-stage" class="fm-stage" aria-hidden="true"></canvas>

  <!-- Header -->
  <header class="fm-header">
    <a class="fm-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <img src="{{ 'fox-meyer-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="120" height="35">
    </a>
    <div class="fm-header-actions">
      {%- comment -%} Native language toggle — renders only once a second locale is published. {%- endcomment -%}
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'fm-lang-form' -%}
          {%- for lang in localization.available_languages -%}
            {%- unless lang.iso_code == localization.language.iso_code -%}
              <button class="fm-lang" type="submit" name="locale_code" value="{{ lang.iso_code }}" lang="{{ lang.iso_code }}" aria-label="{{ lang.endonym_name | capitalize }}">
                {{ lang.iso_code | upcase }}
              </button>
            {%- endunless -%}
          {%- endfor -%}
        {%- endform -%}
      {%- endif -%}
      <a class="fm-btn fm-btn-orange" href="{{ section.settings.shop_link }}">
        {{ section.settings.shop_button_label }}
      </a>
    </div>
  </header>

  <main class="fm-main">

    <!-- Hero -->
    <section id="fm-hero" class="fm-section fm-hero">
      <img class="fm-logo-hero" src="{{ 'fox-meyer-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="560" height="161">
      <h1 class="fm-h1">{{ section.settings.hero_heading }}</h1>
      <p class="fm-hero-sub">{{ section.settings.hero_subheading }}</p>
      <div class="fm-hero-spacer" aria-hidden="true"></div>
      <div class="fm-scroll-cue" aria-hidden="true">
        <span>{{ section.settings.scroll_cue_text }}</span>
        <span class="fm-line"></span>
      </div>
    </section>

    <!-- Freshness -->
    <section id="fm-fraicheur" class="fm-section">
      <div class="fm-panel fm-reveal">
        <p class="fm-eyebrow">{{ section.settings.freshness_eyebrow }}</p>
        <h2 class="fm-h2">{{ section.settings.freshness_heading }}</h2>
        <p class="fm-copy">{{ section.settings.freshness_copy }}</p>
        <div class="fm-chips">
          <span class="fm-chip">{{ section.settings.freshness_chip_1 }}</span>
          <span class="fm-chip fm-chip-green">{{ section.settings.freshness_chip_2 }}</span>
          <span class="fm-chip">{{ section.settings.freshness_chip_3 }}</span>
        </div>
      </div>
    </section>

    <!-- Origin -->
    <section id="fm-origine" class="fm-section">
      <div class="fm-panel fm-panel-right fm-reveal">
        <p class="fm-eyebrow">{{ section.settings.origin_eyebrow }}</p>
        <h2 class="fm-h2">{{ section.settings.origin_heading }}</h2>
        <p class="fm-copy">{{ section.settings.origin_copy }}</p>
        <div class="fm-chips">
          <span class="fm-chip">{{ section.settings.origin_chip_1 }}</span>
          <span class="fm-chip fm-chip-green">{{ section.settings.origin_chip_2 }}</span>
          <span class="fm-chip">{{ section.settings.origin_chip_3 }}</span>
        </div>
      </div>
    </section>

    <!-- Recipe -->
    <section id="fm-recette" class="fm-section">
      <div class="fm-panel fm-reveal">
        <p class="fm-eyebrow">{{ section.settings.recipe_eyebrow }}</p>
        <h2 class="fm-h2">{{ section.settings.recipe_heading }}</h2>
        <div class="fm-recipe">
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_water_value }}<span>{{ section.settings.recipe_water_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_water_label }}</div>
          </div>
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_dose_value }}<span>{{ section.settings.recipe_dose_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_dose_label }}</div>
          </div>
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_yield_value }}<span>{{ section.settings.recipe_yield_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_yield_label }}</div>
          </div>
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_time_value }}<span>{{ section.settings.recipe_time_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_time_label }}</div>
          </div>
        </div>
        <p class="fm-copy">{{ section.settings.recipe_note }}</p>
      </div>
    </section>

    <!-- Petite Grenouille -->
    <section id="fm-grenouille" class="fm-section">
      <div class="fm-panel fm-panel-right fm-reveal">
        <p class="fm-eyebrow">{{ section.settings.grenouille_eyebrow }}</p>
        <h2 class="fm-h2">{{ section.settings.grenouille_heading }}</h2>
        <p class="fm-copy">{{ section.settings.grenouille_copy }}</p>
        <div class="fm-chips">
          <span class="fm-chip">{{ section.settings.grenouille_chip_1 }}</span>
          <span class="fm-chip fm-chip-green">{{ section.settings.grenouille_chip_2 }}</span>
          <span class="fm-chip">{{ section.settings.grenouille_chip_3 }}</span>
        </div>
      </div>
    </section>

    <!-- Recipe — Petite Grenouille -->
    <section id="fm-recette-pg" class="fm-section">
      <div class="fm-panel fm-reveal">
        <p class="fm-eyebrow">{{ section.settings.recipe_pg_eyebrow }}</p>
        <h2 class="fm-h2">{{ section.settings.recipe_pg_heading }}</h2>
        <div class="fm-recipe">
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_pg_water_value }}<span>{{ section.settings.recipe_pg_water_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_pg_water_label }}</div>
          </div>
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_pg_dose_value }}<span>{{ section.settings.recipe_pg_dose_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_pg_dose_label }}</div>
          </div>
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_pg_yield_value }}<span>{{ section.settings.recipe_pg_yield_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_pg_yield_label }}</div>
          </div>
          <div class="fm-spec">
            <div class="fm-num">{{ section.settings.recipe_pg_time_value }}<span>{{ section.settings.recipe_pg_time_unit }}</span></div>
            <div class="fm-lab">{{ section.settings.recipe_pg_time_label }}</div>
          </div>
        </div>
        <p class="fm-copy">{{ section.settings.recipe_pg_note }}</p>
      </div>
    </section>

    <!-- Shop / CTA -->
    <section id="fm-acheter" class="fm-section">
      <div class="fm-cta-card fm-panel fm-panel-right fm-reveal">
        <img class="fm-fox" src="{{ 'fox-meyer-fox.png' | asset_url }}" alt="" aria-hidden="true" width="150" height="auto">
        <p class="fm-eyebrow">{{ section.settings.cta_eyebrow }}</p>
        <h2 class="fm-h2">{{ section.settings.cta_heading }}</h2>
        <div class="fm-price-row">
          <div class="fm-price-tag">
            <span class="fm-price">{{ section.settings.product_1_price }}</span>
            <span class="fm-sku">{{ section.settings.product_1_name }}</span>
            <span class="fm-unit">{{ section.settings.product_1_unit }}</span>
          </div>
          <div class="fm-price-tag">
            <span class="fm-price">{{ section.settings.product_2_price }}</span>
            <span class="fm-sku">{{ section.settings.product_2_name }}</span>
            <span class="fm-unit">{{ section.settings.product_2_unit }}</span>
          </div>
        </div>
        <ul class="fm-tiers">
          <li>
            <span class="fm-qty">{{ section.settings.tier_1_qty }}</span>
            <span>{{ section.settings.tier_1_description }}</span>
          </li>
          <li>
            <span class="fm-qty">{{ section.settings.tier_2_qty }}</span>
            <span>{{ section.settings.tier_2_description }}</span>
          </li>
        </ul>
        <div class="fm-cta-actions">
          <a class="fm-btn fm-btn-orange" href="{{ section.settings.shop_link }}">
            {{ section.settings.cta_shop_label }}
          </a>
          {%- if section.settings.subscribe_link != blank -%}
            <a class="fm-btn fm-btn-ghost" href="{{ section.settings.subscribe_link }}">
              {{ section.settings.cta_subscribe_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </section>

    <!-- Who is Fox Meyer? — about teaser -->
    <section id="fm-about" class="fm-section fm-about-teaser">
      <div class="fm-about-inner fm-reveal">
        <p class="fm-eyebrow">{{ section.settings.about_eyebrow }}</p>
        <h2 class="fm-about-title">{{ section.settings.about_heading }}</h2>
        {%- if section.settings.about_copy != blank -%}
          <p class="fm-copy fm-about-copy">{{ section.settings.about_copy }}</p>
        {%- endif -%}
        <a class="fm-btn fm-btn-orange" href="{{ section.settings.about_link | default: '/pages/about' }}">
          {{ section.settings.about_button_label }}
        </a>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="fm-footer">
    <div class="fm-footer-row">
      <div>
        <a class="fm-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          <img src="{{ 'fox-meyer-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="100" height="29">
        </a>
        <p class="fm-fine" style="margin-top:14px">{{ section.settings.footer_legal | newline_to_br }}</p>
      </div>
      <nav class="fm-footer-links" aria-label="Footer navigation">
        {%- if section.settings.footer_ext_link != blank -%}
          <a href="{{ section.settings.footer_ext_link }}">{{ section.settings.footer_ext_label }}</a>
        {%- endif -%}
        <a href="#fm-fraicheur">{{ section.settings.freshness_eyebrow }}</a>
        <a href="#fm-origine">{{ section.settings.origin_eyebrow }}</a>
        <a href="#fm-grenouille">{{ section.settings.grenouille_eyebrow }}</a>
        <a href="#fm-recette">{{ section.settings.recipe_eyebrow }}</a>
        <a href="#fm-acheter">{{ section.settings.cta_eyebrow }}</a>
        <a href="{{ section.settings.about_link | default: '/pages/about' }}">{{ section.settings.about_eyebrow }}</a>
      </nav>
    </div>
    <p class="fm-fine" style="margin-top:34px">{{ section.settings.footer_copyright }}</p>
  </footer>

</div>

